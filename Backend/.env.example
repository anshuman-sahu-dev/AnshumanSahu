# ==============================================================================
# Environment Configuration — Anshuman Sahu Portfolio Backend
# ==============================================================================

# Server Environment
NODE_ENV=development
PORT=5000

# Client Allowed Origins (CORS Whitelisting)
CLIENT_URL=http://localhost:5173
ADDITIONAL_ALLOWED_ORIGINS=https://anshumansahu.vercel.app

# Database Connectivity (MongoDB Atlas Connection String)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/portfolio?retryWrites=true&w=majority

# Nodemailer / SMTP Email Delivery Credentials
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password_here
SMTP_FROM="Your Name <your_email@gmail.com>"

# Receiver Email Address for Inquiries
NOTIFICATION_RECEIVER_EMAIL=your_admin_email@gmail.com

# Rate Limiting & Abuse Prevention
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=5
